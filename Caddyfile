# FANS-C -- Caddy Reverse Proxy Configuration
# Caddy terminates HTTPS on the barangay LAN and proxies plain HTTP to
# Django/Waitress on 127.0.0.1:8000.
#
# Start from the project root:
#   caddy run --config Caddyfile
#
# cert files must exist in the same folder as this Caddyfile:
#   fans-cert.pem         TLS certificate (public)
#   fans-cert-key.pem     TLS private key  (keep secret, never commit)
#
# Generated by setup-secure-server.ps1 (run once per machine).
# Regenerate: setup-secure-server.ps1 -ForceRegenerateCert

{
    # Disable built-in admin API -- not used; prevents port 2019 conflicts on restart.
    admin off
}

fans-barangay.local {
    # TLS: use the stable mkcert certificate.
    # Paths are relative to the Caddy process working directory (always the project root).
    tls fans-cert.pem fans-cert-key.pem

    # MediaPipe WASM files must be served as application/wasm.
    # Django/whitenoise normally handles this via Python's mimetypes; this rule
    # is a defence-in-depth override at the proxy layer.
    @wasm path *.wasm
    header @wasm Content-Type "application/wasm"

    # ── Security response headers (defence in depth on the LAN) ────────────
    header {
        # Force HTTPS for one year; the LAN cert is locally trusted.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # MIME sniffing off — protects beneficiary photos and embedded JSON.
        X-Content-Type-Options "nosniff"
        # No framing — the verification UI is never embedded; this stops clickjacking.
        X-Frame-Options "DENY"
        # Don't leak referers off the LAN; preserve them within the same origin.
        Referrer-Policy "strict-origin-when-cross-origin"
        # Camera permission is needed for verification, mic and other sensors are not.
        Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
        # Tell intermediaries not to cache responses that may contain biometric data.
        # Django sets per-view cache headers where appropriate; this is the LAN-wide default.
        Cache-Control "no-store"
        # Strip identifying headers added by Caddy itself.
        -Server
    }

    # Proxy all HTTPS traffic to Django on loopback.
    reverse_proxy 127.0.0.1:8000 {
        # Tell Django the original request came over HTTPS.
        # Required for CSRF cookies, Secure flag, and redirect URLs.
        # Django reads this via SECURE_PROXY_SSL_HEADER = ("HTTP_X_FORWARDED_PROTO", "https").
        header_up X-Forwarded-Proto {scheme}
        # Pass the original client IP so Django and audit logs record the real
        # device address rather than the loopback (127.0.0.1).
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        # Pass the original Host header (fans-barangay.local) so Django's
        # USE_X_FORWARDED_HOST=True resolves the correct hostname for URLs.
        header_up X-Forwarded-Host {host}
    }
}
