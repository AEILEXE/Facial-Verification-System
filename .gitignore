# ── Secrets and runtime state ──────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# ── Database ───────────────────────────────────────────────────────────────
*.sqlite3
db.sqlite3

# ── Media and logs ─────────────────────────────────────────────────────────
media/
/media/
*.log

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/

# ── Virtual environment ───────────────────────────────────────────────────
.venv/
venv/
env/

# ── ML model files ────────────────────────────────────────────────────────
*.keras
*.h5
*.pkl
models/weights/

# ── Build output ──────────────────────────────────────────────────────────
dist/
build/
FANS-C-Installer/

# ── Top-level build/install transcript artifacts (v2.1.11) ────────────────
# Build/install transcripts produced by PyInstaller / Inno Setup land at the
# repo root if a build is run without the -q flag. Archive them under
# dev/build-logs/archive/ rather than committing them at the top level.
/build_err.txt
/build_log.txt
/build_log2.txt
/build_out.txt
/build_stderr.txt
/build_stdout.txt
/inno_log.txt
/iscc_out.txt
/pyinstaller_log.txt
# Archive folder itself is committed (placeholder), but its contents are not.
dev/build-logs/archive/*
!dev/build-logs/archive/.gitkeep
!dev/build-logs/archive/README.md

# ── Local database backups (contain PII/biometric data; never publish) ────
/backups/

# ── Collected static files ────────────────────────────────────────────────
# staticfiles/ is the collectstatic output — generated, not committed.
# Vendor source files are committed under static/vendor/ instead.
staticfiles/

# ── Process pid files ─────────────────────────────────────────────────────
.fans-waitress.pid
.fans-caddy.pid

# ── Legacy certs (kept for reference, not used at runtime) ────────────────
legacy/certs/

# ── OS ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.tmp
*.bak
node_modules/

# ── IDE ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
.claude/