# ============================================================
# FANSC Environment Configuration Template
# ============================================================
# HOW TO USE:
#   setup.ps1 copies this file to .env automatically.
#   You can also copy it manually:
#     Copy-Item .env.example .env
#
# NEVER commit .env to git — it contains secrets.
#
# HOW TO GENERATE THE ENCRYPTION KEY:
#   python manage.py generate_key
#   Copy the output into EMBEDDING_ENCRYPTION_KEY below.
#
#   WARNING: If this key is lost or changed, all stored face
#   embeddings become permanently unreadable and beneficiaries
#   must re-register from scratch.
#
# MULTI-DEVICE SETUP:
#   All workstations that share the same central database MUST
#   use the same EMBEDDING_ENCRYPTION_KEY.  Transfer the .env
#   file securely (USB, encrypted message) — never plain email.
# ============================================================

# ── Django Core ────────────────────────────────────────────
# Generate a unique key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Local development:
#   DEBUG=True, ALLOWED_HOSTS=localhost,127.0.0.1
#
# Barangay LAN server -- plain HTTP (camera blocked on client devices):
#   DEBUG=False, ALLOWED_HOSTS=192.168.1.77,localhost,127.0.0.1
#
# Barangay LAN server -- secure HTTPS via Caddy (recommended):
#   DEBUG=False, ALLOWED_HOSTS=fans-barangay.local,192.168.1.77,localhost,127.0.0.1
#   Also set CSRF_TRUSTED_ORIGINS and SECURE_PROXY_SSL_HEADER below.
#   Browsers require HTTPS (secure context) for webcam / getUserMedia access.
#   A plain http:// LAN URL will block camera capture on client devices.
#
# Comma-separated. Whitespace around commas is stripped automatically.
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ───────────────────────────────────────────────
# Local / standalone:    USE_SQLITE=True  (no PostgreSQL needed)
# Centralized server:    USE_SQLITE=False (all clients share one PostgreSQL DB)
USE_SQLITE=True

# PostgreSQL settings — used when USE_SQLITE=False.
# For centralized deployment: set DB_HOST to the server's IP or hostname.
DB_NAME=fans_db
DB_USER=fans_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Connection pooling — keep DB connections alive between requests.
# Set to 60 (seconds) for centralized PostgreSQL deployment.
# Set to 0 to close the connection after every request (SQLite default).
CONN_MAX_AGE=0

# ── Face Embedding Security ────────────────────────────────
# REQUIRED. Generate with:  python manage.py generate_key
# Keep this secret and back it up securely.
# Changing this key makes all stored embeddings unreadable.
EMBEDDING_ENCRYPTION_KEY=

# ── Face Matching Thresholds ───────────────────────────────
# DEMO_MODE=True   Assisted Rollout Mode — uses DEMO_THRESHOLD (0.60).
#                  Liveness is recorded but does NOT block verification.
#                  Use this during gradual deployment to collect data.
# DEMO_MODE=False  Strict Mode — uses VERIFICATION_THRESHOLD (0.75).
#                  Enable only after validating performance on your hardware.
DEMO_MODE=False
DEMO_THRESHOLD=0.60
VERIFICATION_THRESHOLD=0.75

# Max face-scan retries before the fallback ID-check path is offered (default 2)
MAX_RETRY_ATTEMPTS=2

# ── Liveness Settings ──────────────────────────────────────
# LIVENESS_REQUIRED=False  Assisted Rollout Mode: liveness is logged but
#                          never blocks verification. Recommended during rollout.
# LIVENESS_REQUIRED=True   Strict Mode: a failed liveness check denies
#                          the verification. Enable in full production.
#
# NOTE: LIVENESS_REQUIRED controls whether a failed liveness BLOCKS the attempt.
# The head-movement challenge is ALWAYS required for final stipend verification (v2.3.0+),
# regardless of anti-spoof score. REQUIRE_LIVENESS_CHALLENGE applies to registration only.
LIVENESS_REQUIRED=True

# Anti-spoofing texture score threshold (0.0-1.0).
# 0.25 balances false rejects for elderly users while blocking printed photos.
# Raise to 0.30-0.50 in production with a trained anti-spoofing CNN.
ANTI_SPOOF_THRESHOLD=0.25

# Challenge trigger threshold: anti-spoof scores below this value trigger the
# head-movement challenge automatically (matches verify.js threshold of 0.30).
LIVENESS_CHALLENGE_TRIGGER_THRESHOLD=0.30

# Set to True to force the head-movement challenge on EVERY verification attempt
# regardless of anti-spoof score. Default False (risk-based challenge).
# Representative claims always require the challenge independent of this setting.
REQUIRE_LIVENESS_CHALLENGE=False

# Require anti-spoof + head-movement challenge during beneficiary face registration.
# Default True — registration should be stricter than verification to prevent
# phone/screen spoofs from being enrolled as legitimate face embeddings.
REGISTRATION_LIVENESS_REQUIRED=True

# Set to True to force the head-movement challenge on EVERY registration attempt.
# Default False — challenge is risk-based: only required when anti-spoof score is
# below LIVENESS_CHALLENGE_TRIGGER_THRESHOLD (0.30) or face quality is poor.
# Phone/screen enrollments are still blocked by the anti-spoof check regardless.
REGISTRATION_CHALLENGE_REQUIRED=False

# Registration strong-live threshold.  Anti-spoof scores above this value are
# considered clearly-passing live captures and no head-movement challenge is needed.
# Scores in [LIVENESS_CHALLENGE_TRIGGER_THRESHOLD, REGISTRATION_STRONG_LIVE_THRESHOLD)
# may still trigger the challenge if quality is poor.
REGISTRATION_STRONG_LIVE_THRESHOLD=0.50

# ── Media Files ────────────────────────────────────────────
MEDIA_ROOT=media

# ── Reverse-Proxy / HTTPS (centralized server deployment) ──
# Leave all three empty for local development -- they are no-ops when unset.
#
# For barangay LAN deployment behind Caddy with HTTPS using fans-barangay.local:
#
#   CSRF_TRUSTED_ORIGINS=https://fans-barangay.local
#     Required: Caddy terminates TLS and forwards plain HTTP to Django.
#     Django sees plain HTTP internally but browsers send from an https://
#     origin.  Without this, all form POSTs (login, verification, register)
#     are rejected with HTTP 403 Forbidden.
#
#   SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
#     Tells Django to trust the X-Forwarded-Proto header that Caddy sets.
#     This makes SESSION_COOKIE_SECURE and CSRF_COOKIE_SECURE work correctly
#     even though Django itself receives plain HTTP from Caddy.
#
#   USE_X_FORWARDED_HOST=True
#     Use the Host header forwarded by Caddy (fans-barangay.local) rather
#     than the internal address (127.0.0.1:8000).
#
# For raw-IP HTTPS (less preferred, harder to get certs for):
#   CSRF_TRUSTED_ORIGINS=https://192.168.1.77
#
CSRF_TRUSTED_ORIGINS=
SECURE_PROXY_SSL_HEADER=
USE_X_FORWARDED_HOST=False

# ── Secure-cookie mode ──────────────────────────────────────
# Controls whether the Secure flag is set on session and CSRF cookies.
#
#   Default (no entry here):
#     DEBUG=True  → cookies work over http:// (fine for local dev)
#     DEBUG=False → cookies are HTTPS-only (intended for production)
#
#   SECURE_COOKIES=True   Force HTTPS-only cookies regardless of DEBUG.
#   SECURE_COOKIES=False  Allow cookies over plain http:// on EVERY request,
#                         including ones that actually arrived over HTTPS.
#
# v2.2.0 UPDATE — you probably do NOT need to touch this setting anymore.
#   Previously, logging in over the plain-HTTP LAN-IP fallback (e.g.
#   http://192.168.x.x:8000) required setting SECURE_COOKIES=False globally,
#   which also weakened cookie security on the normal HTTPS path.
#   fans.middleware.DynamicCookieSecurityMiddleware now does this
#   automatically and PER-REQUEST: a request that actually arrives over
#   HTTPS keeps Secure-flagged cookies (unchanged, fully secure); only a
#   request that genuinely arrives over plain HTTP gets a non-Secure cookie,
#   so it survives a page refresh. Leave SECURE_COOKIES unset in almost
#   every deployment now — it exists as a manual override only, not a
#   required setting for HTTP fallback access to work.
#
# SECURE_COOKIES=False

# ── Fraud Detection Thresholds (v2.2.0) ────────────────────
# All optional — safe defaults are baked in below. Tune only if the
# defaults are producing too many/too few flags for this deployment's
# actual staff headcount and stipend-day volume. None of these ever cause
# an automatic block/deny — they only control when a signal appears on the
# Security Review page and notifies admins (see docs in verification/fraud_signals.py).
#
# FRAUD_REPEATED_FAILURE_THRESHOLD=3        # failed verifications...
# FRAUD_REPEATED_FAILURE_WINDOW_DAYS=30     # ...within this many days, per beneficiary
# FRAUD_STAFF_VOLUME_THRESHOLD=50           # verification attempts...
# FRAUD_STAFF_VOLUME_WINDOW_HOURS=24        # ...within this many hours, per staff member
# FRAUD_MASS_EDIT_THRESHOLD=20              # user/payout/config edits...
# FRAUD_MASS_EDIT_WINDOW_HOURS=1            # ...within this many hours, per admin
# FRAUD_LOGIN_FAILURE_THRESHOLD=10          # failed logins...
# FRAUD_LOGIN_FAILURE_WINDOW_HOURS=24       # ...within this many hours, per IP address
# FRAUD_PAYOUT_ANOMALY_THRESHOLD=5          # payout overrides/cancellations/failures...
# FRAUD_PAYOUT_ANOMALY_WINDOW_HOURS=24      # ...within this many hours, per staff member

# ── Offline Sync (fallback / secondary mode) ───────────────
# Offline sync is for edge deployments where workstations operate without
# a live network connection to the central server.  In the recommended
# centralized architecture, leave SYNC_API_URL empty — all clients connect
# directly to the shared PostgreSQL database through Django.
#
# The central server must use the SAME EMBEDDING_ENCRYPTION_KEY.
# Transfer it securely — if keys differ, face data will be unreadable.
#
# SYNC_API_URL example: https://central.fans-c.gov.ph/api
SYNC_API_URL=
SYNC_API_KEY=
SYNC_TIMEOUT=30
SYNC_BATCH_SIZE=50

# ── Email / Self-Service Password Reset OTP (v2.2.0 Phase 6) ───────────────
# This deployment is normally LAN-only/offline. Leave EMAIL_HOST blank to
# keep it that way — self-service "forgot password" then shows a clear
# "not configured" message and staff use the admin-mediated fallback
# (Settings > System Administration > Account Recovery Administration)
# instead. Fill these in only if this site has real SMTP access (e.g. a
# Gmail app password, or an internal mail relay).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@fans-c.local
#
# OTP behavior — safe defaults, uncomment only to change them:
# OTP_LENGTH=6
# OTP_EXPIRY_MINUTES=5
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_S=60
# OTP_REQUEST_RATE_LIMIT=5
# OTP_REQUEST_RATE_WINDOW_S=900
